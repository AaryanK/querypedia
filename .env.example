# Railway service reference variable, not a new or browser-visible secret:
# Dedicated per-app token, matching DragonZpyder API's DRAGONZPYDER_APP_KEYS_JSON.querypedia
DRAGONZPYDER_QUERYPEDIA_TOKEN=
# Legacy compatibility only; remove after all deployments are migrated
DRAGONZPYDER_RUNTIME_TOKEN=
# Refer to the existing private DragonZpyder API on Railway:
DRAGONZPYDER_API_URL=http://dragonzpyder-api.railway.internal:8080
QUERYPEDIA_MODEL=openai/gpt-oss-120b
# Replace with a meaningful contact address per Wikimedia User-Agent guidelines:
WIKIMEDIA_USER_AGENT=Querypedia/0.2 (https://querypedia.dragonzpyder.xyz; https://dragonzpyder.xyz)
